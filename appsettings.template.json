{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "GitHub": {
      "ClientId": "YOUR_GITHUB_CLIENT_ID_HERE",
      "ClientSecret": "YOUR_GITHUB_SECRET_HERE"
    },
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID_HERE",
      "ClientSecret": "YOUR_GOOGLE_SECRET_HERE"
    }
  },
  "Azure": {
    "CosmosDB": {
      "ConnectionString": "YOUR_COSMOS_CONNECTION_STRING_HERE",
      "DatabaseName": "StudentDB",
      "ContainerName": "Students"
    },
    "BlobStorage": {
      "ConnectionString": "YOUR_BLOB_CONNECTION_STRING_HERE",
      "ContainerName": "student-images"
    }
  }
}