@{
    ViewData["Title"] = "Dashboard";
}

@if (User.Identity.IsAuthenticated)
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="card-dashboard bg-white p-5 text-center">
                <h1 class="display-4 fw-bold text-primary mb-3">Welcome, @User.Identity.Name!</h1>
                <p class="lead text-muted">Manage your students efficiently with our secure cloud platform</p>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card-dashboard bg-white p-4 h-100">
                <div class="d-flex align-items-center mb-4">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                        <i class="fas fa-users fa-2x text-primary"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">Manage Students</h5>
                        <small class="text-muted">View and edit records</small>
                    </div>
                </div>
                <p class="text-muted mb-4">Access all student records, search, and manage their information.</p>
                <a asp-controller="Student" asp-action="Index" class="btn btn-custom-primary w-100">
                    <i class="fas fa-arrow-right me-2"></i>Go to Students
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card-dashboard bg-white p-4 h-100">
                <div class="d-flex align-items-center mb-4">
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                        <i class="fas fa-user-plus fa-2x text-success"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">Add New Student</h5>
                        <small class="text-muted">Register students</small>
                    </div>
                </div>
                <p class="text-muted mb-4">Add new students with profile pictures and enrollment status.</p>
                <a asp-controller="Student" asp-action="Create" class="btn btn-custom-primary w-100">
                    <i class="fas fa-plus-circle me-2"></i>Add Student
                </a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card-dashboard bg-white p-4 h-100">
                <div class="d-flex align-items-center mb-4">
                    <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3">
                        <i class="fas fa-cloud-upload-alt fa-2x text-info"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0">Secure Storage</h5>
                        <small class="text-muted">Azure Cloud</small>
                    </div>
                </div>
                <p class="text-muted mb-4">Data stored securely in Azure Cosmos DB and Blob Storage.</p>
                <div class="text-muted small">
                    <i class="fas fa-shield-alt me-1 text-success"></i> Encrypted at rest
                    <br>
                    <i class="fas fa-key me-1 text-warning"></i> SAS token security
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="card-dashboard bg-white p-5 text-center">
        <i class="fas fa-graduation-cap fa-4x text-primary mb-4"></i>
        <h1 class="display-4 fw-bold mb-3">FutureTech Academy</h1>
        <p class="lead text-muted mb-4">Student Management System</p>
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="alert alert-info rounded-3">
                    <i class="fas fa-info-circle me-2"></i>
                    Please log in to access the management system
                </div>
            </div>
        </div>
    </div>
}