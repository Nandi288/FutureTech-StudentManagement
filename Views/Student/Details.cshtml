@model FutureTech_StudentManagement.Models.Student
@{
    ViewData["Title"] = "Student Details";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card-dashboard bg-white overflow-hidden">
            <div class="p-5 text-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                @if (ViewBag.SecureImageUrl != null)
                {
                    <img src="@ViewBag.SecureImageUrl" alt="@Model.FullName"
                         class="rounded-circle border border-4 border-white shadow-lg"
                         style="width: 150px; height: 150px; object-fit: cover;">
                }
                else
                {
                    <div class="rounded-circle bg-white bg-opacity-20 d-flex align-items-center justify-content-center mx-auto border border-4 border-white shadow-lg"
                         style="width: 150px; height: 150px;">
                        <span class="display-4 fw-bold text-white">@Model.FirstName[0]@Model.LastName[0]</span>
                    </div>
                }
                <h3 class="text-white mt-4 mb-1 fw-bold">@Model.FullName</h3>
                <p class="text-white-50 mb-0">Student ID: @Model.Id</p>
            </div>

            <div class="p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="bg-light p-3 rounded-3">
                            <small class="text-muted d-block mb-1">Email Address</small>
                            <p class="fw-bold mb-0 d-flex align-items-center">
                                <i class="fas fa-envelope me-2 text-primary" style="width: 20px;"></i>
                                <span>@Model.Email</span>
                            </p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="bg-light p-3 rounded-3">
                            <small class="text-muted d-block mb-1">Mobile Number</small>
                            <p class="fw-bold mb-0 d-flex align-items-center">
                                <i class="fas fa-phone me-2 text-primary" style="width: 20px;"></i>
                                <span>@Model.MobileNumber</span>
                            </p>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="bg-light p-3 rounded-3">
                            <small class="text-muted d-block mb-1">Enrolment Status</small>
                            <div class="d-flex align-items-center">
                                @if (Model.EnrolmentStatus == "Active")
                                {
                                    <span class="badge-active d-inline-flex align-items-center" style="padding: 5px 12px; font-size: 0.9rem;">
                                        <i class="fas fa-circle me-1" style="font-size: 8px;"></i> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-inactive d-inline-flex align-items-center" style="padding: 5px 12px; font-size: 0.9rem;">
                                        <i class="fas fa-circle me-1" style="font-size: 8px;"></i> Inactive
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="bg-light p-3 rounded-3">
                            <small class="text-muted d-block mb-1">Created On</small>
                            <p class="fw-bold mb-0 d-flex align-items-center">
                                <i class="fas fa-calendar me-2 text-primary" style="width: 20px;"></i>
                                <span>@Model.CreatedAt.ToString("dd MMM yyyy")</span>
                            </p>
                        </div>
                    </div>

                    @if (Model.UpdatedAt.HasValue)
                    {
                        <div class="col-md-6">
                            <div class="bg-light p-3 rounded-3">
                                <small class="text-muted d-block mb-1">Last Updated</small>
                                <p class="fw-bold mb-0 d-flex align-items-center">
                                    <i class="fas fa-clock me-2 text-primary" style="width: 20px;"></i>
                                    <span>@Model.UpdatedAt.Value.ToString("dd MMM yyyy")</span>
                                </p>
                            </div>
                        </div>
                    }
                </div>

                <hr class="my-4">

                <div class="d-flex gap-3 justify-content-end">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4">
                        <i class="fas fa-arrow-left me-2"></i>Back
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-custom-primary rounded-3 px-4">
                        <i class="fas fa-edit me-2"></i>Edit Student
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>